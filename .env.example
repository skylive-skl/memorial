# Скопируйте в .env и при необходимости поменяйте значения.
# Значения ниже подходят для локальной разработки через docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origin фронта: браузер ходит только на него, Next проксирует /api/v1/* на Django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_DB=memorial
POSTGRES_USER=memorial
POSTGRES_PASSWORD=memorial
DATABASE_URL=postgres://memorial:memorial@postgres:5432/memorial

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- S3 / MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=memorial-media
# Адрес S3 изнутри docker-сети (для backend и worker)
AWS_S3_ENDPOINT_URL=http://minio:9000
# Публичный адрес бакета, из которого собираются URL медиа для браузера
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/memorial-media

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30

# --- URLs ---
# Базовый URL для ссылок в QR: {PUBLIC_BASE_URL}/m/{code}
PUBLIC_BASE_URL=http://localhost:3000
# Адрес фронта для вызова /api/revalidate из Celery (изнутри docker-сети)
FRONTEND_INTERNAL_URL=http://frontend:3000
# Общий секрет для /api/revalidate (бэк и фронт)
REVALIDATE_SECRET=change-me

# --- Frontend ---
# Куда Next.js проксирует /api/v1/* и куда ходит при серверном рендере
BACKEND_INTERNAL_URL=http://backend:8000
